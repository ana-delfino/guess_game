# ===== Versões das imagens: troque aqui para atualizar um componente =====
BACKEND_IMAGE=guess-game-backend
BACKEND_VERSION=1.0.0
FRONTEND_IMAGE=guess-game-frontend
FRONTEND_VERSION=1.0.0
POSTGRES_VERSION=18-alpine
NGINX_VERSION=1.28-alpine

# ===== Quantidade de réplicas do backend (balanceadas pelo NGINX) =====
BACKEND_REPLICAS=3   # mínimo recomendado: 3 (ver README)

# ===== Porta exposta no host =====
HTTP_PORT=8081

# ===== Banco de dados =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretpass
POSTGRES_DB=postgres
